manuscript/ieee/*.out

# Superseded local rendering scratch space
figures/rendered/

# Noncanonical figure exports and visual-QA overlays. The release contains
# publication PDF/SVG files and the selected JSON audit records instead.
figures/publication/*.png
figures/publication/*.tiff
figures/publication/*.alignment.svg
figures/publication/*.collision-audit.pdf
figures/publication/*.collision-audit.txt
figures/publication/*.collision-audit.collision-audit.*
