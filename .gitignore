# Local Python environments and bytecode
.venv/
__pycache__/
*.py[cod]

# Local C++ build and independent mixed-language experiment outputs
build/
results_cpp/
results_cpp_20261029/

# Non-authoritative experimental outputs
results_smoke/
results_pre_rerun_20261028/
results/analysis/figures/

# Local LaTeX build intermediates; retain the final PDF and source files.
manuscript/
manuscript/ieee/*.aux
manuscript/ieee/*.bbl
manuscript/ieee/*.blg
manuscript/ieee/*.fdb_latexmk
manuscript/ieee/*.fls
